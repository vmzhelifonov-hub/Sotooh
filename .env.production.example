# =============================================================================
# Sotooh — production environment template
# Copy to .env on the server (cp .env.production.example .env) and fill in
# every value before running `make deploy`. NEVER commit the real file.
# =============================================================================

# --------------------------------------------------------------- Domain / TLS
# Your real domain, e.g. sotooh.iq — Caddy will obtain HTTPS automatically.
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# ------------------------------------------------------------------ Postgres
POSTGRES_USER=sotooh
POSTGRES_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
POSTGRES_DB=sotooh
POSTGRES_HOST=postgres

# --------------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------- S3 storage
# Works with MinIO (self-hosted, see S3_PUBLIC_ENDPOINT) or any S3 provider
# (AWS S3, Wasabi, Hetzner, ...). Just point the endpoint URL appropriately.
AWS_ACCESS_KEY_ID=__YOUR_S3_KEY__
AWS_SECRET_ACCESS_KEY=__YOUR_S3_SECRET__
# For self-hosted MinIO inside the compose network:
AWS_S3_ENDPOINT_URL=http://minio:9000
# For a cloud provider, e.g. https://s3.eu-central-1.amazonaws.com
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=sotooh-prod
S3_PUBLIC_ENDPOINT=https://s3.example.com

# ---------------------------------------------------------------- ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=sotooh
CLICKHOUSE_USER=sotooh
CLICKHOUSE_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
CLICKHOUSE_PORT=9000

# ------------------------------------------------------------------- Backend
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=__GENERATE_WITH_python_-c_'import secrets; print(secrets.token_urlsafe(64))'
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SETTINGS_MODULE=config.settings.prod

FRONTEND_PUBLIC_URL=https://example.com
DEFAULT_TIMEZONE=Asia/Baghdad

# -------------------------------------------------------------------- E-mail
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=login
EMAIL_HOST_PASSWORD=password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Sotooh <no-reply@example.com>

# ------------------------------------------------------------------- Airflow
AIRFLOW_UID=1000
AIRFLOW_PROFILE_ENABLED=1
