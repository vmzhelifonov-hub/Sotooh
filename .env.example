# =============================================================================
# Sotooh — local development environment
# Copy to .env (cp .env.example .env) and adjust if needed.
# NEVER commit the real .env file.
# =============================================================================

# ------------------------------------------------------------------ Postgres
POSTGRES_USER=sotooh
POSTGRES_PASSWORD=sotooh_dev_password
POSTGRES_DB=sotooh
# POSTGRES_PORT is the HOST port mapping only.
# Inside the compose network Django always connects to 5432.
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
POSTGRES_INTERNAL_PORT=5432

# --------------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379/0

# --------------------------------------------------------------------- MinIO
# S3-compatible storage (local dev uses MinIO)
AWS_ACCESS_KEY_ID=sotoohminio
AWS_SECRET_ACCESS_KEY=sotoohminio_secret
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=sotooh-local
MINIO_CONSOLE_PORT=9001
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ---------------------------------------------------------------- ClickHouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=sotooh
CLICKHOUSE_USER=sotooh
CLICKHOUSE_PASSWORD=sotooh_clickhouse
CLICKHOUSE_PORT=9000

# ------------------------------------------------------------------- Backend
# Comma-separated list. For local dev with Vite proxy this is enough.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-insecure-secret-change-me
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://frontend:5173
DJANGO_SETTINGS_MODULE=config.settings.dev
BACKEND_PORT=8000

# Default organization timezone (Iraq)
DEFAULT_TIMEZONE=Asia/Baghdad

# Frontend origin used for links inside emails / WhatsApp share text
FRONTEND_PUBLIC_URL=http://localhost:5173

# -------------------------------------------------------------------- E-mail
# Dev: console backend (emails printed to backend logs)
EMAIL_BACKEND=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Sotooh <no-reply@sotooh.local>

# ------------------------------------------------------------------- Airflow
AIRFLOW_UID=1000
AIRFLOW_PROFILE_ENABLED=0
